{
 "_comment": "Israeli factors from Global Factor Data (Jensen, Kelly & Pedersen, jkpfactors.com), used in the Momentum tab (Israel). pipeline/jkp.py downloads the country's monthly factor returns from JKP's public S3 bucket when JKP publishes a new release. themes: the 13 themes (clusters) of the published data, with Hebrew names. factors: every factor's theme (JKP cluster_labels.csv, v0 themes of the published data) and its English label (JKP's availability manifest). Data licence: CC BY-NC 4.0.",
 "country": "isr",
 "weighting": "vw_cap",
 "base": "https://jkpfactors-data.s3.amazonaws.com/public/",
 "page": "https://jkpfactors.com/analysis?tab=performance",
 "themes": [
  {
   "id": "value",
   "name": "ערך",
   "desc": "מניות זולות ביחס להון, לרווח, למכירות ולתזרים, ומניות שמחזירות כסף לבעלי המניות, מול מניות יקרות.",
   "en": "Value"
  },
  {
   "id": "momentum",
   "name": "מומנטום",
   "desc": "מניות שעלו בשנה האחרונה, בלי החודש האחרון, מול מניות שירדו.",
   "en": "Momentum"
  },
  {
   "id": "quality",
   "name": "איכות",
   "desc": "חברות עם רווחיות תפעולית גבוהה, יעילות ויציבות (כולל Quality minus Junk) מול חברות חלשות.",
   "en": "Quality"
  },
  {
   "id": "profitability",
   "name": "רווחיות",
   "desc": "חברות רווחיות ביחס לנכסים ולהון מול חברות עם רווחיות נמוכה.",
   "en": "Profitability"
  },
  {
   "id": "profit_growth",
   "name": "צמיחת רווחים",
   "desc": "חברות שהרווחים והמכירות שלהן משתפרים ומפתיעים לטובה, מול חברות שנחלשות.",
   "en": "Profit Growth"
  },
  {
   "id": "low_risk",
   "name": "סיכון נמוך",
   "desc": "מניות עם תנודתיות ובטא נמוכות מול מניות תנודתיות. ציפייה: רווח דומה בפחות סיכון.",
   "en": "Low Risk"
  },
  {
   "id": "low_leverage",
   "name": "מינוף נמוך",
   "desc": "חברות עם מינוף נמוך, הרבה מזומן ונכסים מוחשיים, ורחוקות מחדלות פירעון, מול ממונפות.",
   "en": "Low Leverage"
  },
  {
   "id": "investment",
   "name": "השקעה שמרנית",
   "desc": "חברות שמגדילות נכסים, השקעות ומכירות לאט, מול חברות שמתרחבות מהר.",
   "en": "Investment"
  },
  {
   "id": "debt_issuance",
   "name": "הנפקת חוב נמוכה",
   "desc": "חברות שמגייסות מעט חוב ומגדילות מעט התחייבויות, מול חברות שמנפיקות הרבה.",
   "en": "Debt Issuance"
  },
  {
   "id": "accruals",
   "name": "אקרואלים נמוכים",
   "desc": "חברות שהרווח שלהן נשען על מזומן ולא על צבירות חשבונאיות, מול ההפך.",
   "en": "Accruals"
  },
  {
   "id": "size",
   "name": "גודל",
   "desc": "מניות קטנות ופחות סחירות מול גדולות.",
   "en": "Size"
  },
  {
   "id": "seasonality",
   "name": "עונתיות",
   "desc": "מניות שהיו חזקות באותו חודש בשנים קודמות, ופקטורים נוספים שמתנהגים דומה.",
   "en": "Seasonality"
  },
  {
   "id": "short_term_reversal",
   "name": "היפוך לטווח קצר",
   "desc": "מניות שירדו בחודש האחרון ומניות עם פחות קפיצות קיצון, מול ההפך: הימור על תיקון.",
   "en": "Short-Term Reversal"
  }
 ],
